{
  "name": "bench-05-json-schema",
  "seedPrompt": "Extract the details from the message.",
  "models": [
    "openai/gpt-5-nano"
  ],
  "serviceModel": "openai/gpt-5-nano",
  "populationSize": 6,
  "generationSize": 6,
  "maxGenerations": 4,
  "budget": 1.0,
  "parallelLimit": 6,
  "seed": 105,
  "samplesPerTest": 1,
  "serviceModelMaxTokens": 2048,
  "retries": 3,
  "operators": {
    "mutationShare": 0.4,
    "crossoverShare": 0.15,
    "metaPrompting": {
      "enabled": true,
      "share": 0.45
    },
    "paramVariation": {
      "enabled": false,
      "share": 0
    },
    "modelVariation": {
      "enabled": false,
      "share": 0
    }
  },
  "fitnessWeights": {
    "quality": 1.0
  },
  "testSet": [
    {
      "name": "flight",
      "mode": "json_schema",
      "prompt": "Booked: Maria Chen, LH441 from Frankfurt to Boston on 12 March 2026, seat 14C, confirmation QX7T2P.",
      "schema": {
        "type": "object",
        "required": [
          "passenger",
          "flight",
          "date",
          "confirmation"
        ],
        "properties": {
          "passenger": {
            "type": "string"
          },
          "flight": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "confirmation": {
            "type": "string"
          }
        }
      },
      "expected": "{\"passenger\":\"Maria Chen\",\"flight\":\"LH441\",\"date\":\"2026-03-12\",\"confirmation\":\"QX7T2P\"}"
    },
    {
      "name": "hotel",
      "mode": "json_schema",
      "prompt": "Reservation for Omar Haddad at the Grand Fjord, checking in 4 July 2026 for 3 nights, ref GF-99120.",
