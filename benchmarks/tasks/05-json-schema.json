            "type": "string"
          },
          "hotel": {
            "type": "string"
          },
          "check_in": {
            "type": "string"
          },
          "nights": {
            "type": "number"
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "expected": "{\"guest\":\"Omar Haddad\",\"hotel\":\"Grand Fjord\",\"check_in\":\"2026-07-04\",\"nights\":3,\"reference\":\"GF-99120\"}"
    },
